# ------------------------------------------------------------------
# Envio Fácil - variáveis de ambiente
# Copie para .env e gere chaves próprias antes de qualquer uso real:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------

# Banco de dados (MySQL 8)
DB_NAME=envio_facil
DB_USER=envio_facil
DB_PASSWORD=troque_esta_senha
DB_ROOT_PASSWORD=troque_esta_senha_root
DB_PORT_HOST=3307

# Portas publicadas no host
WEB_PORT_HOST=8080
API_PORT_HOST=4000
ADMINER_PORT_HOST=8081

# URL pública usada no QR Code. Para testar com celular na mesma rede,
# troque localhost pelo IP da máquina (ex.: http://192.168.0.15:8080).
APP_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Chaves de segurança (OBRIGATÓRIAS em produção, mínimo 32 caracteres)
JWT_SECRET=
DATA_ENCRYPTION_KEY=
CPF_HASH_KEY=
FILE_SIGNING_KEY=

# Integração com a base institucional de cidadãos:
#   demo = base fictícia local (ambiente de demonstração)
#   http = API institucional real (Fase 4)
CIDADAO_PROVIDER=demo
CIDADAO_API_URL=
CIDADAO_API_TOKEN=

# Demonstração sem tela de login (ignorado quando NODE_ENV=production).
# true = a aplicação entra direto, com seletor de perfil no cabeçalho.
LOGIN_DESABILITADO=false

# Carga de dados de demonstração (unidades, usuários e cidadãos fictícios)
SEED_DEMO=true

# Fuso usado para os indicadores "de hoje" e o agrupamento por dia
APP_TIMEZONE=America/Sao_Paulo

LOG_LEVEL=info
